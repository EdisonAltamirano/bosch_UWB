<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>new_uwb</name>
  <version>0.0.0</version>
  <description>ROS2 reception/control for the uwb_sw (NXP board) CMD_* protocol — publishes UwbFrame on /uwb/frame_raw, mirrors legacy_tlv's sensors package structure.</description>
  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensors_interfaces</depend>
  <depend>sensors</depend>

  <test_depend>python3-pytest</test_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
